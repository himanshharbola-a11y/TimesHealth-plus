{
  "name": "timeshealth-plus",
  "version": "1.0.0",
  "private": true,
  "description": "TimesHealth+ \u2014 Yoga, Marathon and Diet in one app",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/ensure-db.mjs && npm run start:dev --workspace @th/api",
    "serve": "node scripts/serve.mjs",
    "apk": "node scripts/build-apk.mjs",
    "mobile": "npm run start --workspace @th/mobile",
    "db:up": "node scripts/ensure-db.mjs",
    "db:push": "npm run db:push --workspace @th/api",
    "db:studio": "npm run db:studio --workspace @th/api",
    "seed": "npm run seed --workspace @th/api",
    "personas": "npm run personas --workspace @th/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @th/api && npm run test:mobile",
    "test:mobile": "tsx --test apps/mobile/src/lib/runMath.test.ts"
  },
  "engines": {
    "node": ">=20"
  }
}