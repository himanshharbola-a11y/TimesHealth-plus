# Copy to apps/api/.env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://timeshealth:timeshealth_dev@localhost:5433/timeshealth
# Comma-separated web origins allowed to call the API (* only in development).
CORS_ORIGINS=*
# Proxies in front of the API: ngrok or one load balancer = 1. Used for the
# client IP in rate limits and logs.
TRUST_PROXY_HOPS=1

# Login provider: firebase (today) or times-sso (stub until the Times SSO team
# supplies its details — see docs/06-migration.md).
AUTH_PROVIDER=firebase

# Firebase service account: a file path (hosting on a PC) OR base64 JSON (cloud).
# Omit both => DEV AUTH MODE (refused in production). Push (FCM) uses this too,
# and stays on Firebase even after login moves to Times SSO.
FIREBASE_SERVICE_ACCOUNT_FILE=../../.secrets/firebase-admin.json
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_PROJECT_ID=

# Accept QA persona tokens alongside real login. Test servers only:
# the API refuses to start with this set in production. `npm run serve`
# overrides it (off unless started with --qa).
ALLOW_DEV_TOKENS=false

# Signing secrets — long random values (e.g. `openssl rand -hex 32`), each
# different. Production refuses to start with a missing or dev value.
BIB_SIGNING_SECRET=
MEDIA_SIGNING_SECRET=
WA_JOIN_SIGNING_SECRET=
# Lifetime of the live race-pass QR, seconds.
BIB_TOKEN_TTL_SECONDS=60

# Recorded-session CDN and signed-URL lifetime.
MEDIA_BASE_URL=
MEDIA_URL_TTL_SECONDS=

# Expo venue scanners allowed to verify race passes: "id:key,id:key", each key
# at least 24 characters. Empty in development allows a local "dev-scanner".
SCANNER_KEYS=

# Refer & Win share links are "<SHARE_BASE_URL>/r/<code>" (web funnel domain).
SHARE_BASE_URL=
# Where a lapsed member is sent from WhatsApp class links to renew.
YOGA_RENEW_URL=

# Same destination as the web "Free 15-min call" form (PRD §9).
DIET_LEAD_WEBHOOK_URL=
# Per-user yoga class link (PRD §B4). Shared link until that exists.
YOGA_CLASS_LINK=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
