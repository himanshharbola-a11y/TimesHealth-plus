{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "outDir": "dist",
    // The monorepo root, so @th/types compiles alongside the API rather than
    // tripping the rootDir check. Output lands at dist/apps/api/src/server.js.
    "rootDir": "../..",
    "types": ["node"],
    "paths": {
      "@th/types": ["../../packages/types/src/index.ts"],
      "@th/types/*": ["../../packages/types/src/*"]
    }
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "test/**/*.ts"]
}
