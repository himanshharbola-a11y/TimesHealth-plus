<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console logging for every profile. Messages and stack traces go through LogRedaction, which
  strips query strings and bearer/persona tokens (docs/04 T10, app.ts serializers). The request
  log itself (web/RequestLogFilter) records only method, path, request id, status and time.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <conversionRule conversionWord="safeMsg" converterClass="timeshealth.server.logging.SafeMessageConverter"/>
    <conversionRule conversionWord="safeEx" converterClass="timeshealth.server.logging.SafeThrowableConverter"/>

    <springProfile name="!prod">
        <property name="TH_PATTERN"
                  value="%d{HH:mm:ss.SSS} %clr(%5p) %clr([%X{reqId:-}]){faint} %clr(%-40.40logger{39}){cyan} : %safeMsg%n%safeEx"/>
    </springProfile>
    <springProfile name="prod">
        <!-- No colours; ISO UTC timestamps for the hosting platform's log store. -->
        <property name="TH_PATTERN"
                  value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX,UTC} %5p [%X{reqId:-}] %logger{39} : %safeMsg%n%safeEx"/>
    </springProfile>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${TH_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
