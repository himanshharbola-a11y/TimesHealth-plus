{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"],
      "@th/types": ["../../packages/types/src/index.ts"],
      "@th/config/*": ["../../packages/config/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/types/src/**/*.ts",
    "../../packages/config/**/*.ts"
  ]
}
